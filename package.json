{
  "name": "prettier-plugin-taskfile",
  "version": "1.3.0",
  "description": "A Prettier plugin for formatting Taskfile YAML files",
  "homepage": "https://github.com/prettier-plugin-taskfile/prettier-plugin-taskfile",
  "type": "commonjs",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "types": "./dist/index.d.ts",
    "default": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "check:dependencies": "node --test scripts/check-dependency-direction.test.cjs && node scripts/check-dependency-direction.cjs",
    "check:exports": "node --test scripts/check-package-exports.test.cjs",
    "test:task": "npm run build && node --test scripts/check-task-semantics.cjs",
    "verify:setup": "bash verification/setup.sh",
    "verify:rename": "bash verification/check.sh",
    "format": "npm run build && prettier --write . --plugin=./dist/index.js",
    "format:check": "npm run build && prettier --check . --plugin=./dist/index.js"
  },
  "keywords": [
    "prettier",
    "plugin",
    "taskfile",
    "formatter"
  ],
  "author": "Keyhoh",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.1",
    "fast-check": "^4.11.0",
    "jest": "^30.4.2",
    "prettier-plugin-taskfile": "^1.2.1",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "prettier": "^3.8.3",
    "yaml": "^2.9.0"
  }
}
